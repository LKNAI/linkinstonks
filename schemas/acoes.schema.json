{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acoes.schema.json",
  "title": "acoes.json: companhias com ações listadas na B3",
  "type": "object",
  "required": [
    "schema_version",
    "companhias"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "companhias": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/companhia"
      }
    }
  },
  "$defs": {
    "nomeOuNulo": {
      "type": [
        "string",
        "null"
      ]
    },
    "companhia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codigo_cvm",
        "pregao",
        "razao_social",
        "emissor",
        "cnpj",
        "setor",
        "indicador_mercado",
        "segmento",
        "tickers",
        "escriturador_b3",
        "detalhe_b3",
        "escriturador_cvm",
        "divergente_b3_cvm",
        "situacao_cvm",
        "listagem",
        "liquidez"
      ],
      "properties": {
        "codigo_cvm": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "pregao": {
          "type": "string",
          "minLength": 1
        },
        "razao_social": {
          "type": "string",
          "minLength": 1
        },
        "emissor": {
          "type": "string",
          "minLength": 1
        },
        "cnpj": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}$"
        },
        "setor": {
          "type": "string"
        },
        "indicador_mercado": {
          "type": "string"
        },
        "segmento": {
          "enum": [
            "NM",
            "N2",
            "N1",
            "MP",
            "B",
            "SO",
            "BN",
            "?"
          ]
        },
        "tickers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ticker",
              "classe",
              "negociacao_desde"
            ],
            "properties": {
              "ticker": {
                "type": "string",
                "pattern": "^[A-Z0-9]{4}[0-9]{1,2}[A-Z]?$"
              },
              "classe": {
                "enum": [
                  "ON",
                  "PN",
                  "PNA",
                  "PNB",
                  "PNC",
                  "PND",
                  "Units",
                  "Outros"
                ]
              },
              "negociacao_desde": {
                "description": "Início de negociação do ticker segundo o FCA da CVM",
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "escriturador_b3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on",
            "pn",
            "bruto_on",
            "bruto_pn"
          ],
          "properties": {
            "on": {
              "$ref": "#/$defs/nomeOuNulo"
            },
            "pn": {
              "$ref": "#/$defs/nomeOuNulo"
            },
            "bruto_on": {
              "type": "string"
            },
            "bruto_pn": {
              "type": "string"
            }
          }
        },
        "detalhe_b3": {
          "type": "boolean"
        },
        "escriturador_cvm": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "atual",
                "inicio",
                "inicio_aproximado",
                "anterior",
                "anterior_inicio",
                "anterior_fim",
                "anterior_ultimo_ano",
                "n_escrituradores"
              ],
              "properties": {
                "atual": {
                  "type": "string",
                  "minLength": 1
                },
                "inicio": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "inicio_aproximado": {
                  "type": "boolean"
                },
                "anterior": {
                  "$ref": "#/$defs/nomeOuNulo"
                },
                "anterior_inicio": {
                  "$ref": "#/$defs/nomeOuNulo"
                },
                "anterior_fim": {
                  "$ref": "#/$defs/nomeOuNulo"
                },
                "anterior_ultimo_ano": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "n_escrituradores": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "divergente_b3_cvm": {
          "type": "boolean"
        },
        "situacao_cvm": {
          "$ref": "#/$defs/nomeOuNulo"
        },
        "listagem": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "desde",
                "desde_incerto",
                "fonte_desde",
                "mercado",
                "segmento_cvm",
                "segmento_divergente"
              ],
              "properties": {
                "desde": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "desde_incerto": {
                  "description": "A data é a da lista da B3 ou um valor que parece padrão no FCA",
                  "type": "boolean"
                },
                "fonte_desde": {
                  "enum": [
                    "CVM FCA",
                    "B3",
                    null
                  ]
                },
                "mercado": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "segmento_cvm": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "segmento_divergente": {
                  "description": "O segmento do FCA difere do da B3; só informativo, nenhum corrige o outro",
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "liquidez": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "categoria",
                "criterio_texto"
              ],
              "properties": {
                "categoria": {
                  "enum": [
                    "sem_ticker",
                    "listagem_recente",
                    "sem_cotacao_no_periodo",
                    "sem_negocios",
                    "presenca_baixa",
                    "presenca_media",
                    "presenca_alta"
                  ]
                },
                "criterio_texto": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    }
  }
}
