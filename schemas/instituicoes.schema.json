{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instituicoes.schema.json",
  "title": "instituicoes.json: gerado de config/instituicoes.yaml",
  "type": "object",
  "required": ["schema_version", "instituicoes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "instituicoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome", "nome_curto", "cor", "cor_depositaria", "papeis", "cnpjs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nome": { "type": "string" },
          "nome_curto": { "type": "string" },
          "cor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "cor_depositaria": { "type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$" },
          "papeis": { "type": "array", "items": { "enum": ["escriturador", "depositaria"] } },
          "cnpjs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}/[0-9]{4}-[0-9]{2}$" } }
        }
      }
    }
  }
}
