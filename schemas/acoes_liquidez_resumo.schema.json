{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acoes_liquidez_resumo.schema.json",
  "title": "acoes_liquidez_resumo.json: por companhia, o que as telas de lista usam (substitui acoes_volume.json)",
  "type": "object",
  "required": [
    "schema_version",
    "meses",
    "mes_parcial",
    "pagina_fonte",
    "fontes_volume",
    "nao_atribuido",
    "companhias",
    "pregoes_mes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "meses": {
      "description": "Os 24 meses fechados, alinhados com volume_mensal (R$ inteiros)",
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      }
    },
    "mes_parcial": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "pagina_fonte": {
      "description": "Página oficial da B3 (Séries Históricas) onde os arquivos COTAHIST são publicados",
      "type": "string",
      "format": "uri"
    },
    "fontes_volume": {
      "description": "Mês (AAAA-MM) -> arquivos oficiais da B3 que sustentam o volume daquele mês: o COTAHIST mensal oficial (`mensal`) ou os diários somados (`diario`, mês corrente)",
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "tipo",
          "arquivos"
        ],
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "enum": [
              "mensal",
              "diario"
            ]
          },
          "arquivos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "nao_atribuido": {
      "description": "Volume que não casa com nenhuma companhia do cadastro (ex.: ticker de empresa deslistada). Companhias + não atribuído = total do mercado nos arquivos da B3.",
      "type": "object",
      "required": [
        "tickers",
        "volume_mensal"
      ],
      "additionalProperties": false,
      "properties": {
        "tickers": {
          "type": "integer",
          "minimum": 0
        },
        "volume_mensal": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "companhias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "codigo_cvm",
          "pregao",
          "tickers",
          "negocios_24m",
          "volume_24m",
          "volume_mensal",
          "volume_mes_parcial",
          "agregados",
          "meses_negocios_suspeitos",
          "ticker_principal",
          "ultimo_pregao"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo_cvm": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "pregao": {
            "type": "string",
            "minLength": 1
          },
          "tickers": {
            "description": "Tickers da companhia que tiveram volume no período",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negocios_24m": {
            "type": "integer",
            "minimum": 0
          },
          "volume_24m": {
            "type": "integer",
            "minimum": 0
          },
          "volume_mensal": {
            "description": "R$ inteiros por mês fechado, alinhados com `meses`",
            "type": "array",
            "minItems": 24,
            "maxItems": 24,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "volume_mes_parcial": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "agregados": {
            "description": "Janelas de 3, 6 e 12 meses fechados",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "3m",
              "6m",
              "12m"
            ],
            "properties": {
              "3m": {
                "$ref": "#/$defs/agregado"
              },
              "6m": {
                "$ref": "#/$defs/agregado"
              },
              "12m": {
                "$ref": "#/$defs/agregado"
              }
            }
          },
          "meses_negocios_suspeitos": {
            "description": "Meses em que o número de negócios pode estar subestimado (limite de 5 dígitos do COTAHIST)",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            }
          },
          "ticker_principal": {
            "type": [
              "string",
              "null"
            ]
          },
          "ultimo_pregao": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "pregoes_mes": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Datas distintas do arquivo de cada mês (todo o mercado)"
    }
  },
  "$defs": {
    "agregado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dias_com_negocio",
        "negocios",
        "pregoes",
        "presenca",
        "ticket_medio",
        "volume"
      ],
      "properties": {
        "dias_com_negocio": {
          "type": "integer",
          "minimum": 0
        },
        "negocios": {
          "type": "integer",
          "minimum": 0
        },
        "pregoes": {
          "type": "integer",
          "minimum": 0
        },
        "presenca": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "ticket_medio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "volume": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
