{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot_acoes.schema.json",
  "title": "snapshots/AAAA-MM/acoes.json: posição compacta de um mês passado (item 8.6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mes", "reconstituido", "coletado_em", "companhias"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "mes": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "reconstituido": { "type": "boolean" },
    "coletado_em": { "type": ["string", "null"] },
    "companhias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigo_cvm", "pregao", "razao_social", "emissor", "cnpj", "setor", "segmento", "tickers", "escriturador", "escriturador_cvm"],
        "properties": {
          "codigo_cvm": { "type": "string" },
          "pregao": { "type": "string" },
          "razao_social": { "type": "string" },
          "emissor": { "type": "string" },
          "cnpj": { "type": "string" },
          "setor": { "type": "string" },
          "segmento": { "type": "string" },
          "escriturador": { "type": ["string", "null"] },
          "tickers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ticker", "classe"],
              "properties": { "ticker": { "type": "string" }, "classe": { "type": "string" } }
            }
          },
          "escriturador_cvm": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["atual", "inicio", "inicio_aproximado", "anterior", "anterior_inicio", "anterior_fim"],
            "properties": {
              "atual": { "type": "string" },
              "inicio": { "type": "string" },
              "inicio_aproximado": { "type": "boolean" },
              "anterior": { "type": ["string", "null"] },
              "anterior_inicio": { "type": ["string", "null"] },
              "anterior_fim": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
