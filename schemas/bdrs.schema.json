{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bdrs.schema.json",
  "title": "bdrs.json: BDRs negociados na B3 com depositária e volume mensal",
  "type": "object",
  "required": ["schema_version", "meses", "mes_parcial", "bdrs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "meses": {
      "description": "Os 24 meses fechados, alinhados com volume_mensal (R$ inteiros)",
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" }
    },
    "mes_parcial": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "bdrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker", "nome", "tipo", "isin", "depositaria", "fonte_depositaria", "categoria", "qualificado",
          "primeiro_pregao", "ultimo_pregao", "ultimo_preco", "negocios_24m", "volume_24m", "volume_mensal",
          "volume_mes_parcial"
        ],
        "properties": {
          "ticker": { "type": "string", "pattern": "^[A-Z0-9]{4}3[1-59]$" },
          "nome": { "type": "string", "minLength": 1 },
          "tipo": { "enum": ["DRN", "DRE", "DR1", "DR2", "DR3"] },
          "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
          "depositaria": { "type": "string", "minLength": 1 },
          "fonte_depositaria": { "type": "string" },
          "categoria": { "type": "string" },
          "qualificado": { "type": "boolean" },
          "primeiro_pregao": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "ultimo_pregao": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "ultimo_preco": { "type": "number", "minimum": 0 },
          "negocios_24m": { "type": "integer", "minimum": 0 },
          "volume_24m": { "type": "integer", "minimum": 0 },
          "volume_mensal": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24,
            "items": { "type": "integer", "minimum": 0 }
          },
          "volume_mes_parcial": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
